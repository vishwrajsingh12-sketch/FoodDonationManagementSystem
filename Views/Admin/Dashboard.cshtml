@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}


<div class="container mt-5">


    <!-- HEADER -->

    <div class="mb-5">

        <h2 class="fw-bold" style="color:#064E3B">

            👨‍💼 Admin Dashboard

        </h2>


        <p class="text-muted">

            Manage users, donations and monitor the complete Food Donation System.

        </p>

    </div>





    <!-- STAT CARDS -->


    <div class="row">



        <div class="col-lg-3 col-md-6 mb-4">

            <div class="card text-center p-4 dashboard-card"
                 style="background:linear-gradient(135deg,#dbeafe,#ffffff);">


                <div style="font-size:45px">

                    👥

                </div>


                <h5 class="mt-3">

                    Total Users

                </h5>


                <h2 class="fw-bold text-primary">

                    @ViewBag.TotalUsers

                </h2>


            </div>

        </div>







        <div class="col-lg-3 col-md-6 mb-4">


            <div class="card text-center p-4 dashboard-card"
                 style="background:linear-gradient(135deg,#d1fae5,#ffffff);">


                <div style="font-size:45px">

                    🍱

                </div>


                <h5 class="mt-3">

                    Total Donations

                </h5>


                <h2 class="fw-bold text-success">

                    @ViewBag.TotalDonations

                </h2>


            </div>


        </div>







        <div class="col-lg-3 col-md-6 mb-4">


            <div class="card text-center p-4 dashboard-card"
                 style="background:linear-gradient(135deg,#fef3c7,#ffffff);">


                <div style="font-size:45px">

                    ⏳

                </div>


                <h5 class="mt-3">

                    Pending

                </h5>


                <h2 class="fw-bold text-warning">

                    @ViewBag.Pending

                </h2>


            </div>


        </div>







        <div class="col-lg-3 col-md-6 mb-4">


            <div class="card text-center p-4 dashboard-card"
                 style="background:linear-gradient(135deg,#ccfbf1,#ffffff);">


                <div style="font-size:45px">

                    ✅

                </div>


                <h5 class="mt-3">

                    Completed

                </h5>


                <h2 class="fw-bold" style="color:#0F766E">

                    @ViewBag.Completed

                </h2>


            </div>


        </div>



    </div>







    <!-- MANAGEMENT CARDS -->


    <div class="row mt-4">



        <div class="col-md-4 mb-4">


            <div class="card text-center p-4">


                <h1>

                    👥

                </h1>


                <h5>

                    Manage Users

                </h5>


                <p class="text-muted">

                    View and manage registered users.

                </p>



                <a asp-controller="Admin"
                   asp-action="Users"
                   class="btn btn-success">

                    View Users

                </a>


            </div>


        </div>







        <div class="col-md-4 mb-4">


            <div class="card text-center p-4">


                <h1>

                    🍱

                </h1>


                <h5>

                    Manage Donations

                </h5>


                <p class="text-muted">

                    View all food donations.

                </p>



                <a asp-controller="Admin"
                   asp-action="Donations"
                   class="btn btn-success">

                    View Donations

                </a>


            </div>


        </div>







        <div class="col-md-4 mb-4">


            <div class="card text-center p-4">


                <h1>

                    📂

                </h1>


                <h5>

                    Categories

                </h5>


                <p class="text-muted">

                    Manage food categories.

                </p>



                <a asp-controller="Category"
                   asp-action="Index"
                   class="btn btn-success">

                    Manage Categories

                </a>


            </div>


        </div>



    </div>







    <!-- CHART -->


    <div class="card mt-4 p-4">


        <h3 class="text-center fw-bold"
            style="color:#064E3B">


            📊 Donation Status Analytics


        </h3>



        <div style="height:400px;max-width:450px;margin:auto">


            <canvas id="donationChart"></canvas>


        </div>


    </div>



</div>









@section Scripts {


    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>



    <script>


        var pending = @(ViewBag.Pending ?? 0);

        var completed = @(ViewBag.Completed ?? 0);



        if (pending == 0 && completed == 0) {
            pending = 1;
            completed = 1;
        }



        const ctx =
            document.getElementById('donationChart');



        new Chart(ctx, {

            type: 'doughnut',


            data: {

                labels: [

                    'Pending',
                    'Completed'

                ],


                datasets: [{

                    data: [

                        pending,
                        completed

                    ]

                }]


            },


            options: {


                responsive: true,


                plugins: {


                    legend: {


                        position: 'bottom'


                    }


                }


            }


        });



    </script>


}