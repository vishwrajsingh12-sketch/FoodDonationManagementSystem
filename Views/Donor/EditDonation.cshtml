@model FoodDonationManagementSystem.Models.Donation

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Edit Donation";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white text-center py-3">
                    <h2>✏ Edit Donation</h2>
                    <p class="mb-0">Update your donation details</p>
                </div>

                <div class="card-body">

                    <form asp-action="EditDonation"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="DonationId" />

                        <input type="hidden"
                               asp-for="FoodImage" />

                        <div asp-validation-summary="All"
                             class="text-danger"></div>

                        <div class="mb-3">

                            <label class="fw-bold">
                                Food Name
                            </label>

                            <input asp-for="FoodName"
                                   class="form-control" />

                            <span asp-validation-for="FoodName"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-3">

                            <label class="fw-bold">
                                Food Type
                            </label>

                            <select asp-for="FoodType"
                                    class="form-select">

                                <option>Veg</option>
                                <option>Non Veg</option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label class="fw-bold">
                                Quantity
                            </label>

                            <input asp-for="Quantity"
                                   class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label class="fw-bold">
                                Expiry Date
                            </label>

                            <input asp-for="ExpiryDate"
                                   type="date"
                                   class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label class="fw-bold">
                                Pickup Address
                            </label>

                            <textarea asp-for="PickupAddress"
                                      class="form-control"
                                      rows="3"></textarea>

                        </div>

                        <div class="mb-3">

                            <label class="fw-bold">
                                Change Image
                            </label>

                            <input type="file"
                                   name="imageFile"
                                   class="form-control"
                                   accept="image/*"
                                   onchange="previewImage(event)" />

                        </div>

                        <div class="text-center mb-4">

                            <img id="preview"
                                 src="@Model.FoodImage"
                                 class="img-thumbnail"
                                 style="max-height:220px;" />

                        </div>

                        <div class="d-grid gap-2">

                            <button class="btn btn-primary btn-lg"
                                    type="submit">

                                💾 Update Donation

                            </button>

                            <a asp-action="MyDonations"
                               class="btn btn-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function previewImage(event) {
            var reader = new FileReader();

            reader.onload = function() {
                document.getElementById("preview").src = reader.result;
            }

            reader.readAsDataURL(event.target.files[0]);
        }

    </script>

}