@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Donor Dashboard";
}



<div class="container mt-5">



    <!-- HEADER -->


    <div class="mb-5">


        <h2 class="fw-bold"
            style="color:#064E3B">

            👋 Welcome Donor

        </h2>


        <p class="text-muted">

            Manage your food donations and help people in need.

        </p>


    </div>







    <!-- STAT CARDS -->


    <div class="row">



        <div class="col-lg-4 col-md-6 mb-4">


            <div class="card text-center p-4 dashboard-card h-100"
                 style="background:linear-gradient(135deg,#d1fae5,#ffffff);">


                <div style="font-size:50px">

                    🍱

                </div>


                <h5 class="fw-bold mt-3">

                    Total Donations

                </h5>


                <h2 class="fw-bold text-success">

                    @ViewBag.TotalDonation

                </h2>


            </div>


        </div>








        <div class="col-lg-4 col-md-6 mb-4">


            <div class="card text-center p-4 dashboard-card h-100"
                 style="background:linear-gradient(135deg,#fef3c7,#ffffff);">


                <div style="font-size:50px">

                    ⏳

                </div>


                <h5 class="fw-bold mt-3">

                    Pending Donations

                </h5>


                <h2 class="fw-bold text-warning">

                    @ViewBag.Pending

                </h2>


            </div>


        </div>








        <div class="col-lg-4 col-md-6 mb-4">


            <div class="card text-center p-4 dashboard-card h-100"
                 style="background:linear-gradient(135deg,#ccfbf1,#ffffff);">


                <div style="font-size:50px">

                    ✅

                </div>


                <h5 class="fw-bold mt-3">

                    Completed Donations

                </h5>


                <h2 class="fw-bold"
                    style="color:#0F766E">

                    @ViewBag.Completed

                </h2>


            </div>


        </div>



    </div>







    <!-- DONATION ACTION CARD -->


    <div class="card mt-4 p-5 text-center">


        <h1>

            🍲

        </h1>


        <h3 class="fw-bold"
            style="color:#064E3B">

            Donate Food

        </h3>



        <p class="text-muted">

            Your extra food can become someone's meal and bring happiness.

        </p>





        <div class="mt-3">



            <a asp-controller="Donor"
               asp-action="AddDonation"
               class="btn btn-success btn-lg me-2">


                ➕ Add Donation


            </a>





            <a asp-controller="Donor"
               asp-action="MyDonations"
               class="btn btn-outline-success btn-lg">


                📦 My Donations


            </a>



        </div>



    </div>




</div>