<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Food Donation</title>


    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>


<body>


    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-success">

            <div class="container">


                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    🍲 Food Donation

                </a>



                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">

                    <span class="navbar-toggler-icon"></span>

                </button>




                <div class="collapse navbar-collapse"
                     id="navbarNav">


                    <ul class="navbar-nav ms-auto">



                        @if (User.Identity.IsAuthenticated)
                        {


                            <!-- COMMON MENU -->


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">

                                    🏠 Home

                                </a>

                            </li>



                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="About">

                                    ℹ️ About

                                </a>

                            </li>



                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Contact"
                                   asp-action="Index">

                                    📞 Contact

                                </a>

                            </li>





                            <!-- DONOR MENU -->
                            @if (User.IsInRole("Donor"))
                            {

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Donor"
                                       asp-action="Dashboard">

                                        👤 Donor Dashboard

                                    </a>

                                </li>



                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Donor"
                                       asp-action="AddDonation">

                                        ➕ Add Donation

                                    </a>

                                </li>



                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Donor"
                                       asp-action="MyDonations">

                                        📦 My Donations

                                    </a>

                                </li>

                            }





                            <!-- NGO MENU -->
                            @if (User.IsInRole("NGO"))
                            {


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="NGO"
                                       asp-action="Dashboard">

                                        🏢 NGO Dashboard

                                    </a>

                                </li>



                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="NGO"
                                       asp-action="AvailableDonations">

                                        🍱 Available Food

                                    </a>

                                </li>


                            }





                            <!-- ADMIN MENU -->
                            @if (User.IsInRole("Admin"))
                            {


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Dashboard">

                                        👨‍💼 Admin Dashboard

                                    </a>

                                </li>



                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Category"
                                       asp-action="Index">

                                        🍽 Categories

                                    </a>

                                </li>



                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Contact"
                                       asp-action="Messages">

                                        📩 Messages

                                    </a>

                                </li>


                            }






                            <!-- LOGOUT -->


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Logout">

                                    🚪 Logout

                                </a>

                            </li>


                        }

                        else
                        {


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">

                                    🏠 Home

                                </a>

                            </li>



                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="About">

                                    ℹ️ About

                                </a>

                            </li>




                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Contact"
                                   asp-action="Index">

                                    📞 Contact

                                </a>

                            </li>




                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    🔐 Login

                                </a>

                            </li>



                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    📝 Register

                                </a>

                            </li>


                        }



                    </ul>


                </div>


            </div>

        </nav>


    </header>






    <div class="container mt-4">

        <main role="main">

            @RenderBody()

        </main>

    </div>







    <footer class="text-center mt-5 p-4 bg-white shadow-sm">


        <h5 class="text-success fw-bold">

            🍲 Food Donation Management System

        </h5>


        <p class="mb-1">

            Reduce Food Waste | Help People | Spread Happiness ❤️

        </p>


        <small>

            © 2026 All Rights Reserved

        </small>


    </footer>







    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"></script>


    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>