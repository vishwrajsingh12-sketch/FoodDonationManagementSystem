@model IEnumerable<FoodDonationManagementSystem.Models.Contact>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Contact Messages";
}


<div class="container mt-5">


    <div class="mb-4">

        <h2 class="text-danger fw-bold">

            📩 Contact Messages

        </h2>


        <p class="text-muted">

            View messages sent by users.

        </p>

    </div>





    @if (!Model.Any())
    {

        <div class="alert alert-info text-center">

            <h4>
                No Messages Found
            </h4>

            <p>
                No one has contacted yet.
            </p>

        </div>

    }
    else
    {


        <div class="row">


            @foreach (var item in Model)
            {


                <div class="col-md-6 mb-4">


                    <div class="card shadow border-0 rounded-4">


                        <div class="card-body">


                            <h4 class="text-success fw-bold">

                                👤 @item.Name

                            </h4>


                            <hr />



                            <p>

                                <b>📧 Email:</b>

                                @item.Email

                            </p>



                            <p>

                                <b>📌 Subject:</b>

                                @item.Subject

                            </p>




                            <p>

                                <b>💬 Message:</b>

                                <br />

                                @item.Message

                            </p>




                            <p class="text-muted">

                                🕒 @item.CreatedAt.ToString("dd-MM-yyyy hh:mm tt")

                            </p>





                            <form asp-action="Delete"
                                  method="post"
                                  onsubmit="return confirm('Delete this message?');">


                                @Html.AntiForgeryToken()


                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />



                                <button type="submit"
                                        class="btn btn-danger">

                                    🗑 Delete

                                </button>


                            </form>



                        </div>


                    </div>


                </div>


            }


        </div>


    }


</div>