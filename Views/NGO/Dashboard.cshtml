@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "NGO Dashboard";
}


<div class="container mt-5">


    <!-- HEADER -->

    <div class="mb-5">


        <h2 class="fw-bold"
            style="color:#064E3B">

            🏢 NGO Dashboard

        </h2>


        <p class="text-muted">

            Manage food donations and help distribute meals to people in need.

        </p>


    </div>







    <!-- STAT CARDS -->


    <div class="row">



        <div class="col-lg-3 col-md-6 mb-4">


            <div class="card text-center p-4 dashboard-card h-100"
                 style="background:linear-gradient(135deg,#d1fae5,#ffffff);">


                <div style="font-size:45px">

                    🍱

                </div>


                <h5 class="mt-3">

                    Total Donations

                </h5>


                <h2 class="fw-bold text-success">

                    @ViewBag.TotalFood

                </h2>


            </div>


        </div>








        <div class="col-lg-3 col-md-6 mb-4">


            <div class="card text-center p-4 dashboard-card h-100"
                 style="background:linear-gradient(135deg,#fef3c7,#ffffff);">


                <div style="font-size:45px">

                    ⏳

                </div>


                <h5 class="mt-3">

                    Pending

                </h5>


                <h2 class="fw-bold text-warning">

                    @ViewBag.PendingFood

                </h2>


            </div>


        </div>







        <div class="col-lg-3 col-md-6 mb-4">


            <div class="card text-center p-4 dashboard-card h-100"
                 style="background:linear-gradient(135deg,#dbeafe,#ffffff);">


                <div style="font-size:45px">

                    🤝

                </div>


                <h5 class="mt-3">

                    Accepted

                </h5>


                <h2 class="fw-bold text-primary">

                    @ViewBag.AcceptedFood

                </h2>


            </div>


        </div>







        <div class="col-lg-3 col-md-6 mb-4">


            <div class="card text-center p-4 dashboard-card h-100"
                 style="background:linear-gradient(135deg,#ccfbf1,#ffffff);">


                <div style="font-size:45px">

                    ✅

                </div>


                <h5 class="mt-3">

                    Completed

                </h5>


                <h2 class="fw-bold"
                    style="color:#0F766E">

                    @ViewBag.CompletedFood

                </h2>


            </div>


        </div>



    </div>







    <!-- ACTION CARD -->


    <div class="card mt-4 p-5 text-center">


        <h1>

            🍲

        </h1>


        <h3 class="fw-bold"
            style="color:#064E3B">


            Food Donation Management


        </h3>



        <p class="text-muted">


            View available food, accept donations and complete pickups.


        </p>



        <div>


            <a asp-controller="NGO"
               asp-action="AvailableDonations"
               class="btn btn-success btn-lg">


                📦 View Available Donations


            </a>


        </div>



    </div>



</div>