@{
    ViewData["Title"] = "Home";
}



<!-- HERO SECTION -->


<section class="py-5"
         style="background:linear-gradient(135deg,#064E3B,#059669);">


    <div class="container">


        <div class="row align-items-center">



            <div class="col-lg-6 text-white">


                <h1 class="display-3 fw-bold">


                    🍲 Food Donation
                    <br />

                    Management System


                </h1>



                <p class="lead mt-4">


                    Donate extra food, reduce food waste and connect
                    with verified NGOs to help people in need.


                </p>




                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn btn-light btn-lg mt-3 me-3">


                    🚀 Get Started


                </a>




                <a asp-controller="Home"
                   asp-action="About"
                   class="btn btn-outline-light btn-lg mt-3">


                    ℹ️ Learn More


                </a>



            </div>







            <div class="col-lg-6 text-center mt-4">


                <img src="~/images/food-donation.png"
                     class="img-fluid"
                     style="max-height:430px;filter:drop-shadow(0 20px 30px rgba(0,0,0,.3));" />


            </div>




        </div>


    </div>


</section>








<!-- FEATURES -->


<section class="container py-5">



    <div class="text-center mb-5">


        <h2 class="fw-bold"
            style="color:#064E3B">


            Why Choose Our Platform?


        </h2>


        <p class="text-muted">

            Making food donation simple, fast and meaningful.

        </p>


    </div>






    <div class="row">





        <div class="col-md-4 mb-4">


            <div class="card text-center p-5 h-100">



                <h1>

                    🍱

                </h1>



                <h4 class="fw-bold">

                    Easy Donation

                </h4>



                <p class="text-muted">

                    Donate extra food in just a few clicks.

                </p>



            </div>


        </div>








        <div class="col-md-4 mb-4">


            <div class="card text-center p-5 h-100">



                <h1>

                    🏢

                </h1>



                <h4 class="fw-bold">

                    Verified NGOs

                </h4>



                <p class="text-muted">

                    NGOs collect and distribute food safely.

                </p>



            </div>


        </div>








        <div class="col-md-4 mb-4">


            <div class="card text-center p-5 h-100">



                <h1>

                    ❤️

                </h1>



                <h4 class="fw-bold">

                    Help People

                </h4>



                <p class="text-muted">

                    Every donation creates happiness.

                </p>



            </div>


        </div>





    </div>


</section>









<!-- HOW IT WORKS -->


<section class="py-5"
         style="background:#ECFDF5;">


    <div class="container">



        <h2 class="text-center fw-bold mb-5"
            style="color:#064E3B">


            How It Works


        </h2>





        <div class="row text-center">





            <div class="col-md-3 mb-4">

                <h1>

                    1️⃣

                </h1>


                <h5 class="fw-bold">

                    Register

                </h5>


                <p>

                    Create your account.

                </p>


            </div>







            <div class="col-md-3 mb-4">

                <h1>

                    2️⃣

                </h1>


                <h5 class="fw-bold">

                    Add Food

                </h5>


                <p>

                    Upload donation details.

                </p>


            </div>







            <div class="col-md-3 mb-4">

                <h1>

                    3️⃣

                </h1>


                <h5 class="fw-bold">

                    NGO Pickup

                </h5>


                <p>

                    NGO accepts donation.

                </p>


            </div>







            <div class="col-md-3 mb-4">

                <h1>

                    4️⃣

                </h1>


                <h5 class="fw-bold">

                    Help People

                </h5>


                <p>

                    Food reaches needy people.

                </p>


            </div>



        </div>


    </div>


</section>









<!-- CTA -->


<section class="py-5 text-center">


    <div class="container">


        <div class="card p-5">


            <h2 class="fw-bold"
                style="color:#064E3B">


                Start Donating Today ❤️


            </h2>



            <p class="lead text-muted">


                Your one meal can make someone's day.


            </p>




            <a asp-controller="Account"
               asp-action="Register"
               class="btn btn-success btn-lg">


                🍲 Donate Now


            </a>



        </div>


    </div>


</section>