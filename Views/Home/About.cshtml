@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "About Us";
}


<div class="container mt-5">


    <div class="card shadow-lg border-0 rounded-4 p-5">


        <div class="text-center">


            <h1 class="text-success fw-bold">

                🍲 About Food Donation System

            </h1>


            <p class="text-muted mt-3">

                A platform that connects food donors with NGOs
                to reduce food wastage and help needy people.

            </p>


        </div>



        <hr />



        <div class="row mt-4">


            <div class="col-md-4 text-center mb-4">


                <h1>
                    🤝
                </h1>


                <h4 class="text-success">
                    Our Mission
                </h4>


                <p>
                    To make food donation simple, fast and effective
                    by connecting people who have extra food with
                    organizations who need it.
                </p>


            </div>





            <div class="col-md-4 text-center mb-4">


                <h1>
                    🌱
                </h1>


                <h4 class="text-success">
                    Our Vision
                </h4>


                <p>
                    Reduce food wastage and create a community
                    where every meal can help someone in need.
                </p>


            </div>





            <div class="col-md-4 text-center mb-4">


                <h1>
                    ❤️
                </h1>


                <h4 class="text-success">
                    How It Works
                </h4>


                <p>
                    Donors upload food details, NGOs accept
                    donations and distribute food to needy people.
                </p>


            </div>



        </div>



    </div>


</div>