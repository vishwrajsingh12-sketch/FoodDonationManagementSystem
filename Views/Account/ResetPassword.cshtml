@model FoodDonationManagementSystem.Models.ViewModels.ResetPasswordViewModel

@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Reset Password";
}



<div class="login-background">


    <div class="container">


        <div class="row justify-content-center align-items-center"
             style="min-height:90vh;">





            <div class="col-lg-5 col-md-7">






                <div class="card shadow-lg border-0 p-5 login-card">





                    <div class="text-center mb-4">



                        <div style="font-size:60px;">

                            🔑

                        </div>




                        <h2 class="fw-bold"
                            style="color:#064E3B;">


                            Reset Password


                        </h2>




                        <p class="text-muted">

                            Create a new secure password.

                        </p>




                    </div>








                    <form asp-action="ResetPassword"
                          method="post">



                        @Html.AntiForgeryToken()






                        <input asp-for="Email"
                               type="hidden" />



                        <input asp-for="Token"
                               type="hidden" />








                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>









                        <div class="mb-4">


                            <label class="fw-bold">

                                🔒 New Password

                            </label>



                            <input asp-for="Password"
                                   type="password"
                                   class="form-control form-control-lg"
                                   placeholder="Enter new password" />



                            <span asp-validation-for="Password"
                                  class="text-danger"></span>



                        </div>








                        <div class="mb-4">


                            <label class="fw-bold">

                                🔒 Confirm Password

                            </label>



                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control form-control-lg"
                                   placeholder="Confirm password" />



                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>



                        </div>








                        <button type="submit"
                                class="btn btn-success btn-lg w-100">


                            🔐 Reset Password


                        </button>






                    </form>








                    <div class="text-center mt-4">


                        <a asp-action="Login"
                           class="text-success fw-bold">


                            ← Back to Login


                        </a>


                    </div>







                </div>







            </div>



        </div>



    </div>



</div>







@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}